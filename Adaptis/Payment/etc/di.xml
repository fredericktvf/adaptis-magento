<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <type name="Adaptis\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">Adaptis\Payment\Model\Ui\ConfigProvider::CODE</argument>
        </arguments>
    </type>

    <virtualType name="AdaptisPaymentFacade" type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="code" xsi:type="const">Adaptis\Payment\Model\Ui\ConfigProvider::CODE</argument>
            <argument name="formBlockType" xsi:type="string">Magento\Payment\Block\Form</argument>
            <argument name="infoBlockType" xsi:type="string">Adaptis\Payment\Block\Sales\Order\Info</argument>
            <argument name="valueHandlerPool" xsi:type="object">AdaptisPaymentValueHandlerPool</argument>
            <argument name="commandPool" xsi:type="object">AdaptisPaymentCommandPool</argument>
            <argument name="logger" xsi:type="object">Adaptis\Payment\Logger\Logger</argument>
        </arguments>
    </virtualType>

    <virtualType name="AdaptisPaymentValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">AdaptisPaymentConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="AdaptisPaymentConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">Adaptis\Payment\Gateway\Config\Config</argument>
        </arguments>
    </virtualType>

    <virtualType name="AdaptisPaymentCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="initialize" xsi:type="string">AdaptisPaymentInitializeCommand</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="AdaptisPaymentInitializeCommand" type="Magento\Payment\Gateway\Command\GatewayCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">AdaptisInitializationRequest</argument>
            <argument name="transferFactory" xsi:type="object">Adaptis\Payment\Gateway\Http\TransferFactory</argument>
            <argument name="client" xsi:type="object">Adaptis\Payment\Gateway\Http\Client\Client</argument>
            <argument name="logger" xsi:type="object">Adaptis\Payment\Logger\Logger</argument>
        </arguments>
    </virtualType>

    <virtualType name="AdaptisInitializationRequest" type="Magento\Payment\Gateway\Request\BuilderComposite">
        <arguments>
            <argument name="builders" xsi:type="array">
                <item name="transaction" xsi:type="string">Adaptis\Payment\Gateway\Request\InitializationRequest</item>
            </argument>
        </arguments>
    </virtualType>

    <type name="Adaptis\Payment\Gateway\Request\InitializationRequest">
        <arguments>
            <argument name="config" xsi:type="object">Adaptis\Payment\Gateway\Config\Config</argument>
        </arguments>
    </type>
    
    <type name="Adaptis\Payment\Logger\Handler\Base">
        <arguments>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </type>

    <type name="Adaptis\Payment\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">adaptis_payment</argument>
            <argument name="handlers" xsi:type="array">
                <item name="base" xsi:type="object">Adaptis\Payment\Logger\Handler\Base</item>
            </argument>
        </arguments>
    </type>

</config>